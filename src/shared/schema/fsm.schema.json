{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Avatar model FSM",
  "description": "FSM file as written by generate_fsm.py and read by load_custom_fsm() in src/video/roServer.cpp. Clips are referenced by their original names (metadata keys).",
  "type": "object",
  "additionalProperties": false,
  "required": ["fsms"],
  "properties": {
    "fsms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/fsm" }
    }
  },
  "$defs": {
    "clipName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*\\.mp4$"
    },
    "fsm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "initial_state", "states"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "initial_state": {
          "description": "Index into states[].",
          "type": "integer",
          "minimum": 0
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/state" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "loop", "loop_count", "paths"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "id": {
          "description": "Unique within the FSM. Values in path.transition refer to these ids.",
          "type": "integer",
          "minimum": 0
        },
        "loop": { "type": "boolean" },
        "loop_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clips", "transition"],
      "properties": {
        "clips": {
          "description": "Clips played in order. Each clip's last frame should match the next clip's first frame.",
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/clipName" }
        },
        "transition": {
          "description": "Ids of states that can follow this path.",
          "type": "array",
          "maxItems": 256,
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        }
      }
    }
  }
}
